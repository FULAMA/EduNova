# EduNova environment
EDUNOVA_ENVIRONMENT=development

# JWT
# En production, utiliser une valeur longue, aleatoire et secrete.
EDUNOVA_JWT_SECRET=change-this-secret-in-production

# JWT expiration
EDUNOVA_ACCESS_TOKEN_EXPIRE_MINUTES=15
EDUNOVA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
EDUNOVA_DATABASE_PATH=edunova.db

# CORS
# Plusieurs origines peuvent etre separees par des virgules.
EDUNOVA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
