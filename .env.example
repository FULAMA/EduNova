# EduNova environment
# development | test | staging | production
EDUNOVA_ENVIRONMENT=development

# JWT
# En production, utiliser une valeur longue (32 caracteres minimum),
# aleatoire et secrete, par exemple: python -c "import secrets; print(secrets.token_urlsafe(48))"
EDUNOVA_JWT_SECRET=

# JWT expiration
EDUNOVA_ACCESS_TOKEN_EXPIRE_MINUTES=15
EDUNOVA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
EDUNOVA_DATABASE_PATH=edunova.db

# CORS: liste d origines explicites separees par des virgules.
# Le joker "*" est interdit en staging et en production.
EDUNOVA_CORS_ALLOWED_ORIGINS=

# Documentation OpenAPI (/docs, /redoc, /openapi.json).
# Desactivee par defaut hors development et test.
EDUNOVA_DOCS_ENABLED=true

# Limitation de debit des endpoints d authentification.
EDUNOVA_AUTH_RATE_LIMIT_ATTEMPTS=10
EDUNOVA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
